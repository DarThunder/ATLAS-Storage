# Holder URL and token (blob storage)
HOLDER_URL=http://localhost:8080
HOLDER_API_TOKEN=

# ATLAS database (SQLite for now; Postgres: postgresql+psycopg://user:pass@host/atlas)
ATLAS_DB_URL=sqlite:///./atlas.db

# Initial user (only created if no user exists yet)
ATLAS_ADMIN_USER=admin
ATLAS_ADMIN_PASSWORD=change-this

# Set to true if you serve ATLAS behind HTTPS
ATLAS_COOKIE_SECURE=false

# Limits and paths
ATLAS_SESSION_TTL_DAYS=30
ATLAS_MAX_UPLOAD_MB=2048
ATLAS_TMP_DIR=